  },
  "repository": {
    "type": "git",
    "url": "git+https://repository.url/here.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://repository.url/here/issues"
  },
  "homepage": "https://repository.url/here#readme",
  "dependencies": {
    "@types/node": "^18.11.12",
    "@types/react": "^18.0.17",
    "@types/react-dom": "^18.0.6",
    "axios": "^0.27.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.8.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/react-router-dom": "^5.3.3",
    "eslint": "^8.22.0",
